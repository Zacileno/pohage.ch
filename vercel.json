{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:lang(en|fr|it|cs)/index.html",
      "destination": "/:lang/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Content-Language",
          "value": "de"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Content-Language",
          "value": "de"
        }
      ]
    },
    {
      "source": "/prodej",
      "headers": [
        {
          "key": "Content-Language",
          "value": "de"
        }
      ]
    },
    {
      "source": "/servis",
      "headers": [
        {
          "key": "Content-Language",
          "value": "de"
        }
      ]
    },
    {
      "source": "/opravy",
      "headers": [
        {
          "key": "Content-Language",
          "value": "de"
        }
      ]
    },
    {
      "source": "/kontakt",
      "headers": [
        {
          "key": "Content-Language",
          "value": "de"
        }
      ]
    },
    {
      "source": "/termin",
      "headers": [
        {
          "key": "Content-Language",
          "value": "de"
        }
      ]
    },
    {
      "source": "/404",
      "headers": [
        {
          "key": "Content-Language",
          "value": "de"
        }
      ]
    },
    {
      "source": "/en",
      "headers": [
        {
          "key": "Content-Language",
          "value": "en"
        }
      ]
    },
    {
      "source": "/en/",
      "headers": [
        {
          "key": "Content-Language",
          "value": "en"
        }
      ]
    },
    {
      "source": "/en/:path*",
      "headers": [
        {
          "key": "Content-Language",
          "value": "en"
        }
      ]
    },
    {
      "source": "/fr",
      "headers": [
        {
          "key": "Content-Language",
          "value": "fr"
        }
      ]
    },
    {
      "source": "/fr/",
      "headers": [
        {
          "key": "Content-Language",
          "value": "fr"
        }
      ]
    },
    {
      "source": "/fr/:path*",
      "headers": [
        {
          "key": "Content-Language",
          "value": "fr"
        }
      ]
    },
    {
      "source": "/it",
      "headers": [
        {
          "key": "Content-Language",
          "value": "it"
        }
      ]
    },
    {
      "source": "/it/",
      "headers": [
        {
          "key": "Content-Language",
          "value": "it"
        }
      ]
    },
    {
      "source": "/it/:path*",
      "headers": [
        {
          "key": "Content-Language",
          "value": "it"
        }
      ]
    },
    {
      "source": "/cs",
      "headers": [
        {
          "key": "Content-Language",
          "value": "cs"
        }
      ]
    },
    {
      "source": "/cs/",
      "headers": [
        {
          "key": "Content-Language",
          "value": "cs"
        }
      ]
    },
    {
      "source": "/cs/:path*",
      "headers": [
        {
          "key": "Content-Language",
          "value": "cs"
        }
      ]
    }
  ]
}
